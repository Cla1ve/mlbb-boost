{
  "name": "boost-mlbb",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "serve -l 3000 --no-clipboard .",
    "start": "serve -l 3000 --no-clipboard .",
    "news:build": "node scripts/news-pipeline.mjs build",
    "news:image": "node scripts/news-image.mjs",
    "news:validate": "node scripts/news-pipeline.mjs validate",
    "site:assets": "node scripts/site-assets.mjs",
    "site:sync-data": "node scripts/sync-public-data.mjs",
    "site:build": "node scripts/site-build.mjs && npm run news:build",
    "site:validate": "node scripts/validate-site.mjs && npm run news:validate",
    "test": "node scripts/test-calibration-routes.cjs && node scripts/test-worker.cjs",
    "site:prepare": "npm run site:build && npm run site:validate && npm test",
    "worker:deploy": "wrangler deploy",
    "worker:dev": "wrangler dev"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "linkedom": "^0.18.13",
    "serve": "^14.2.4",
    "sharp": "^0.35.5",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "turndown": "^7.2.0"
  }
}
